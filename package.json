{
  "name": "node-tlcv",
  "version": "0.1.0",
  "description": "Backend Server for viewing TLCV chess games.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "jake": "^12.10.1"
  },
  "dependencies": {
    "async-lock": "^1.4.0",
    "chalk": "^4.1.2",
    "chart.js": "^4.5.1",
    "chess.js": "^1.0.0-beta.6",
    "chessboardjs": "^0.0.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.9",
    "dompurify": "^3.4.17",
    "dotenv": "^10.0.0",
    "express": "^4.22.3",
    "express-basic-auth": "^1.2.0",
    "jquery": "^3.6.0",
    "markdown-it": "^14.3.3",
    "mkdirp": "^3.0.1",
    "on-finished": "^2.3.0",
    "prom-client": "^15.1.3",
    "serve-index": "^1.9.1",
    "slugify": "^1.6.6",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.7.1",
    "ssh2": "^1.17.0",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/async-lock": "^1.4.0",
    "@types/compression": "^1.7.1",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jquery": "^4.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.43",
    "@types/on-finished": "^2.3.1",
    "@types/serve-index": "^1.9.1",
    "@types/ssh2": "^1.15.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "rimraf": "^6.1.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.backend.json",
    "check": "svelte-check --tsconfig ./web/tsconfig.json --fail-on-warnings",
    "clean": "rimraf build",
    "dev-public": "vite build --watch",
    "dev-server": "TS_NODE_PROJECT=tsconfig.backend.json nodemon --legacy-watch --watch src --watch shared -x node --loader ts-node/esm src/main.ts",
    "format": "prettier --write \"{src,shared,web}/**/*.{ts,svelte,css,html}\"",
    "prebuild": "vite build",
    "lint": "eslint --fix src shared web",
    "start": "node build/src/main.js",
    "test": "echo OK",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,shared,web}/**/*.{ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{src,shared,web}/**/*.{css,html}": [
      "prettier --write"
    ]
  },
  "author": "Jay Honnold <jayhonnold@gmail.com>",
  "license": "MIT",
  "type": "module"
}
